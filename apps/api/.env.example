# ============================================================
#  @site-mg/api — Variables d'environnement
#  Copier vers .env et adapter. JAMAIS de valeurs réelles ici (§22).
# ============================================================

# Port d'écoute (défaut 3201)
PORT=3201

# PostgreSQL (docker compose : service "db", port hôte 6543 — 5432 déjà pris en local)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL="postgresql://sitemg:sitemg_dev@localhost:6543/sitemg"

# Redis (docker compose : service "redis", port hôte 6380 — 6379 déjà pris en local)
# Prévu pour les stories sessions/rate-limiting — aucun module ne le lit encore (Sprint 01).
REDIS_URL="redis://localhost:6380"

# CORS (origins autorisées pour le navigateur, séparées par des virgules)
CORS_ORIGIN=http://localhost:3200
